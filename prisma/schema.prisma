generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  supabaseId  String   @unique
  name        String
  email       String?  @unique
  isGuest     Boolean  @default(false)
  avatarUrl   String?
  // Coins/gems are in-app currency only. There is intentionally no
  // withdrawal or cash-conversion path anywhere in the schema or API -
  // coins can be earned or purchased, but only ever spent in-app
  // (tournament entries, shop items). Do not add a redemption/withdraw
  // field without a legal review - see /areas/ludo-live.md.
  coins       Int      @default(500)
  gems        Int      @default(0)
  createdAt   DateTime @default(now())

  matchPlayers      MatchPlayer[]
  tournamentEntries TournamentEntry[]
}

model Match {
  id        String   @id @default(cuid())
  roomCode  String
  winnerId  String?
  playedAt  DateTime @default(now())

  players   MatchPlayer[]
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  userId   String
  color    String
  won      Boolean @default(false)

  match    Match   @relation(fields: [matchId], references: [id])
  user     User    @relation(fields: [userId], references: [id])
}

model DailyReward {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastClaim  DateTime?
  streak     Int      @default(0)
}

model LeaderboardEntry {
  id       String @id @default(cuid())
  userId   String @unique
  wins     Int    @default(0)
  gamesPlayed Int @default(0)
}

// Coin-based tournament. Entry fee and prize pool are both in coins -
// there is no real-money field on this model. If real-money entry fees
// are ever added, that requires a gambling license (see chat notes) and
// should be a completely separate model, not a field bolted onto this one.
model Tournament {
  id          String    @id @default(cuid())
  name        String
  entryFee    Int // coins
  prizePool   Int       @default(0) // coins, accumulates as players join
  maxPlayers  Int       @default(4)
  status      String    @default("open") // open | in_progress | completed | cancelled
  winnerId    String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  entries TournamentEntry[]
}

model TournamentEntry {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}